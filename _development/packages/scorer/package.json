{
  "name": "@bixisoft/scorer",
  "version": "0.1.0",
  "description": "Shared SEO / AEO / GEO / Speed page-check engine used by the WordPress plugin dashboard and the public URL scanner.",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
